# ── 本地開發用範本：複製為 .env 後填值。正式值一律走 Secret Manager，不進 repo。──

# Neon dev branch 連線字串（本地一律用 dev branch，不碰正式 DB）
DATABASE_URL=postgres://user:password@ep-xxx.aws.neon.tech/nba?sslmode=require

# Anthropic dev workspace key（低 spend limit；未經 Hank 確認不得使用正式 key）
ANTHROPIC_API_KEY=sk-ant-dev-xxx

# Cloudflare ↔ Cloud Run 共享 header secret（9C.1 A5）
CF_ORIGIN_SECRET=change-me

# 前端呼叫 API 的 base URL（本地指向 Hono dev server）
NUXT_PUBLIC_API_BASE=http://localhost:8787

# Hono dev server port
PORT=8787

# LLM provider：mock（預設，不打 API）| anthropic（需 ANTHROPIC_API_KEY，本地只用 dev key）
LLM_PROVIDER=mock
